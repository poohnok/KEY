local function UpdateVisual(btn, state, prefix)
    if state then
        btn.Text = prefix .. " 적용 됨"
        btn.BackgroundColor3 = Color3.fromRGB(46, 125, 50)
    else
        btn.Text = prefix .. " 적용 안됨"
        btn.BackgroundColor3 = Color3.fromRGB(38, 38, 41)
    end
end

-- [이동 속도를 실시간으로 강제 주입하는 동적 매커니즘]
local function ApplySpeed(value)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = value
    end
end

