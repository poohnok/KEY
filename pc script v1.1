local KeyDatabaseURL = "https://raw.githack.com/poohnok/KEY/main/key.txt"
local ValidKeys = {"frank@13579", "qwer123", "asdf456"}
local AuthFileName = "ScriptKey_Auth.txt"

if isfile and isfile(AuthFileName) then
    pcall(function() delfile(AuthFileName) end)
end

local function RefreshKeys()
    local cacheBuster = KeyDatabaseURL .. "?t=" .. tostring(os.time())
    local success, result = pcall(function()
        return HttpService:GetAsync(cacheBuster)
    end)
    if success and result then
        for key in result:gmatch("[^\r\n]+") do
            local cleanedKey = key:match("^%s*(.-)%s*$")
            cleanedKey = cleanedKey:gsub("[%c%s]", "")
            if cleanedKey ~= "" and not table.find(ValidKeys, cleanedKey) then
                table.insert(ValidKeys, cleanedKey)
            end
        end
    end
end

local function SaveAuth()
    if writefile then pcall(function() writefile(AuthFileName, "Authorized") end) end
end

