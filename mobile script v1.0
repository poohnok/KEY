end)

local FlySpeed = 50
local FlyEnabled = false
local AimbotEnabled = false
local TpIconEnabled = false
local OriginalPosition = nil

local FlyBtn
local AimBtn
local TpToggleBtn

local function UpdateVisual(btn, state, prefix)
    if state then
        btn.Text = prefix .. " 적용 됨"
        btn.BackgroundColor3 = Color3.fromRGB(46, 125, 50)
    else
        btn.Text = prefix .. " 적용 안됨"
        btn.BackgroundColor3 = Color3.fromRGB(38, 38, 41)
    end
end

YesBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
    AimbotEnabled = false
    FlyEnabled = false
    TpIconEnabled = false
    OriginalPosition = nil
end)

NoBtn.MouseButton1Click:Connect(function()
    ConfirmFrame.Visible = false
    Main.Visible = true
end)

local function GetTarget()
    local t, d = nil, math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
            local mag = (p.Character.Head.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if mag < d then t = p.Character.Head d = mag end
        end
    end
    return t
end

local function CreateBtn(pos)
    local btn = Instance.new("TextButton", Main)
    btn.Size = UDim2.new(0.88, 0, 0, 44)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(38, 38, 41)
    btn.TextColor3 = Color3.fromRGB(240, 240, 245)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    
    local c = Instance.new("UICorner", btn)
    c.CornerRadius = UDim.new(0, 8)
    
    return btn
end

FlyBtn = CreateBtn(UDim2.new(0.06, 0, 0.22, 0))
local function ToggleFly()
    if ScreenGui.Parent == nil then return end
    FlyEnabled = not FlyEnabled
    UpdateVisual(FlyBtn, FlyEnabled, "FLY:")
end
FlyBtn.MouseButton1Click:Connect(ToggleFly)
UpdateVisual(FlyBtn, FlyEnabled, "FLY:")

AimBtn = CreateBtn(UDim2.new(0.06, 0, 0.45, 0))
local function ToggleAim()
    if ScreenGui.Parent == nil then return end
    AimbotEnabled = not AimbotEnabled
    UpdateVisual(AimBtn, AimbotEnabled, "AIMBOT:")
end
AimBtn.MouseButton1Click:Connect(ToggleAim)
UpdateVisual(AimBtn, AimbotEnabled, "AIMBOT:")

TpToggleBtn = CreateBtn(UDim2.new(0.06, 0, 0.68, 0))
local function ToggleTpIcon()
    if ScreenGui.Parent == nil then return end
    TpIconEnabled = not TpIconEnabled
    UpdateVisual(TpToggleBtn, TpIconEnabled, "TELEPORT ICON:")
    TpTouchBtn.Visible = TpIconEnabled
    
    if not TpIconEnabled and OriginalPosition and LocalPlayer.Character then
        LocalPlayer.Character.HumanoidRootPart.CFrame = OriginalPosition
        OriginalPosition = nil
    end
end
TpToggleBtn.MouseButton1Click:Connect(ToggleTpIcon)
UpdateVisual(TpToggleBtn, TpIconEnabled, "TELEPORT ICON:")

local isTeleporting = false

TpTouchBtn.InputBegan:Connect(function(input)
    if ScreenGui.Parent == nil or not TpIconEnabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local target = GetTarget()
        if target and LocalPlayer.Character and not isTeleporting then
            isTeleporting = true
            OriginalPosition = LocalPlayer.Character.HumanoidRootPart.CFrame
            LocalPlayer.Character.HumanoidRootPart.CFrame = target.CFrame * CFrame.new(0, 0, 1.2) * CFrame.Angles(0, math.pi, 0)
        end
    end
end)

TpTouchBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if isTeleporting then
            isTeleporting = false
            if OriginalPosition and LocalPlayer.Character then
                LocalPlayer.Character.HumanoidRootPart.CFrame = OriginalPosition
            end
            OriginalPosition = nil
        end
    end
end)

local dragging, dragStart, startPos
MainTitle.InputBegan:Connect(function(input)
    if ScreenGui.Parent == nil then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
        
        local connection
        connection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                connection:Disconnect()
            end
        end)
    end
end)

MainTitle.InputChanged:Connect(function(input)
    if ScreenGui.Parent == nil then return end
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local dragMini, miniStart, miniStartPos
MiniIcon.InputBegan:Connect(function(input)
    if ScreenGui.Parent == nil then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragMini = true
        miniStart = input.Position
        miniStartPos = MiniIcon.Position
        
        local connection
        connection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragMini = false
                connection:Disconnect()
            end
        end)
    end
end)

MiniIcon.InputChanged:Connect(function(input)
    if ScreenGui.Parent == nil then return end
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragMini then
        local delta = input.Position - miniStart
        MiniIcon.Position = UDim2.new(miniStartPos.X.Scale, miniStartPos.X.Offset + delta.X, miniStartPos.Y.Scale, miniStartPos.Y.Offset + delta.Y)
    end
end)

local dragTp, tpStart, tpStartPos
TpTouchBtn.InputBegan:Connect(function(input)
    if ScreenGui.Parent == nil or not TpIconEnabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        tpStart = input.Position
        tpStartPos = TpTouchBtn.Position
        dragTp = true
        
        local connection
        connection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragTp = false
                connection:Disconnect()
            end
        end)
    end
end)

TpTouchBtn.InputChanged:Connect(function(input)
    if ScreenGui.Parent == nil or not TpIconEnabled then return end
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragTp then
        local delta = input.Position - tpStart
        if delta.Magnitude > 7 then 
            TpTouchBtn.Position = UDim2.new(tpStartPos.X.Scale, tpStartPos.X.Offset + delta.X, tpStartPos.Y.Scale, tpStartPos.Y.Offset + delta.Y)
        end
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if ScreenGui.Parent == nil then return end
    if FlyEnabled and LocalPlayer.Character then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        hrp.Velocity = Vector3.new(0,0,0)
        local m = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then m = m + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then m = m - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then m = m - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then m = m + Camera.CFrame.RightVector end
        hrp.CFrame = hrp.CFrame + (m * FlySpeed * dt)
    end
    if AimbotEnabled then
        local target = GetTarget()
        if target then Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position) end
    end
    if isTeleporting and OriginalPosition then
        local target = GetTarget()
        if target and LocalPlayer.Character then
            LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
            LocalPlayer.Character.HumanoidRootPart.CFrame = target.CFrame * CFrame.new(0, 0, 1.2) * CFrame.Angles(0, math.pi, 0)
        end
    end
end)
