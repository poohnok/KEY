end)

local function OpenMainUI()
    UpdateTabVisuals("움직임")
    for tName, tFrame in pairs(TabFrames) do
        tFrame.Visible = (tName == "움직임")
    end
    Main.Visible = true
end

SubmitBtn.MouseButton1Click:Connect(function()
    local input = KeyInput.Text:gsub("[%c%s]", "")
    StatusMsg.Text = "인증 확인 중..."
    StatusMsg.TextColor3 = Color3.fromRGB(200, 200, 200)
    task.wait(0.2)
    pcall(RefreshKeys)
    if table.find(ValidKeys, input) then
        SaveAuth()
        KeyFrame.Visible = false
        OpenMainUI()
        StatusMsg.Text = ""
    else
        StatusMsg.Text = "올바르지 않은 키입니다. 다시 확인해 주세요."
        StatusMsg.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == MenuBind then
            if KeyFrame.Visible == false and ConfirmFrame.Visible == false then
                Main.Visible = not Main.Visible
            end
        elseif input.KeyCode == SpeedBind then
            ToggleSpeed()
        elseif input.KeyCode == FlyBind then
            ToggleFly()
        elseif input.KeyCode == AimBind then
            ToggleAim()
        elseif input.KeyCode == TpBind then
            DoTeleport()
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gpe)
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == TpBind then
        ResetTeleport()
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if ScreenGui.Parent == nil then return end
    
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        
        if isTeleporting then
            if not UserInputService:IsKeyDown(TpBind) then
                ResetTeleport()
            else
                local target = GetTarget()
                if target then
                    hrp.Velocity = Vector3.new(0,0,0)
                    hrp.CFrame = target.CFrame * CFrame.new(0, 0, 1.2) * CFrame.Angles(0, math.pi, 0)
                end
            end
        end
        
        if CF_SpeedEnabled and not FlyEnabled and not isTeleporting and hum and hum.MoveDirection.Magnitude > 0 then
            local moveDir = hum.MoveDirection
            local calculatedMove = moveDir * 4.5 * dt * 60
            
            local raycastParams = RaycastParams.new()
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
            
            local origin = hrp.Position
            local raycastResult = workspace:Raycast(origin, moveDir * 1.8, raycastParams)
            
            if not raycastResult then
                hrp.CFrame = hrp.CFrame + calculatedMove
            end
        end
        
        if FlyEnabled then
            hrp.Velocity = Vector3.new(0,0,0)
            local m = Vector3.new(0,0,0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then m = m + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then m = m - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then m = m - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then m = m + Camera.CFrame.RightVector end
            hrp.CFrame = hrp.CFrame + (m * FlySpeed * dt)
        end
    end
    
    if AimbotEnabled then
        local target = GetTarget()
        if target then 
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            ApplyTargetESP(target)
        else
            RemoveTargetHighlight()
        end
    else
        RemoveTargetHighlight()
    end
end)

local dragging, dragStart, startPos
MainTitle.InputBegan:Connect(function(input)
    if ScreenGui.Parent == nil then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
        
        local connection
        connection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                connection:Disconnect()
            end
        end)
    end
end)

MainTitle.InputChanged:Connect(function(input)
    if ScreenGui.Parent == nil then return end
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

task.spawn(function()
    if CheckAuth() then
        OpenMainUI()
    else
        KeyFrame.Visible = true
    end
end)
