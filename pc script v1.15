local function CreateContentBtn(parent, initialText, pos)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 42)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(38, 38, 41)
    btn.TextColor3 = Color3.fromRGB(240, 240, 245)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.Text = initialText
    btn.BorderSizePixel = 0
    
    local c = Instance.new("UICorner", btn)
    c.CornerRadius = UDim.new(0, 6)
    return btn
end

local function CreateContentBox(parent, placeholder, text, pos)
    local box = Instance.new("TextBox", parent)
    box.Size = UDim2.new(1, 0, 0, 42)
    box.Position = pos
    box.PlaceholderText = placeholder
    box.Text = text
    box.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize = 13
    box.Font = Enum.Font.GothamBold
    box.BorderSizePixel = 0
    
    local c = Instance.new("UICorner", box)
    c.CornerRadius = UDim.new(0, 6)
    return box
end

local function CreateContentLabel(parent, text, pos)
    local label = Instance.new("TextLabel", parent)
    label.Size = UDim2.new(1, 0, 0, 25)
    label.Position = pos
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(180, 180, 185)
    label.TextSize = 12
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = text
    return label
end

local function UpdateVisual(btn, state, prefix)
    if state then
        btn.Text = prefix .. " 적용 됨"
        btn.BackgroundColor3 = Color3.fromRGB(46, 125, 50)
    else
        btn.Text = prefix .. " 적용 안됨"
        btn.BackgroundColor3 = Color3.fromRGB(38, 38, 41)
    end
end

local SpeedBtn = CreateContentBtn(MovementFrame, "스피드핵 적용 안됨", UDim2.new(0, 0, 0, 10))

local function ToggleSpeed()
    if ScreenGui.Parent == nil then return end
    CF_SpeedEnabled = not CF_SpeedEnabled
    UpdateVisual(SpeedBtn, CF_SpeedEnabled, "스피드핵")
end
