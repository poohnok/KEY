    if num then FlySpeed = num end
    FlySpeedInput.Text = "플라이 속도 " .. tostring(FlySpeed)
end)

local function RemoveTargetHighlight()
    if TargetHighlight then
        TargetHighlight:Destroy()
        TargetHighlight = nil
    end
    CurrentTargetModel = nil
end

local AimBtn = CreateContentBtn(AimFrame, "에임봇 적용 안됨", UDim2.new(0, 0, 0, 10))
local function ToggleAim()
    if ScreenGui.Parent == nil then return end
    AimbotEnabled = not AimbotEnabled
    UpdateVisual(AimBtn, AimbotEnabled, "에임봇")
    if not AimbotEnabled then
        RemoveTargetHighlight()
    end
end
AimBtn.MouseButton1Click:Connect(ToggleAim)

local DynamicTpBindLabel
local function UpdateTpBindText(keyName)
    if DynamicTpBindLabel then
        DynamicTpBindLabel.Text = "[" .. keyName .. "] 키를 꾹 누르면 적 뒤로 이동합니다"
    end
end

local function CreateBindRow(parent, labelText, defaultBind, pos, callback)
    local container = Instance.new("Frame", parent)
    container.Size = UDim2.new(1, 0, 0, 32)
    container.Position = pos
    container.BackgroundTransparency = 1
    
    local lbl = Instance.new("TextLabel", container)
    lbl.Size = UDim2.new(0.5, 0, 1, 0)
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(220, 220, 225)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamBold
    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    
    local btn = Instance.new("TextButton", container)
    btn.Size = UDim2.new(0.45, 0, 0.9, 0)
    btn.Position = UDim2.new(0.55, 0, 0.05, 0)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
    btn.TextColor3 = Color3.fromRGB(0, 120, 255)
    btn.Text = defaultBind.Name
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.BorderSizePixel = 0
    
    local c = Instance.new("UICorner", btn)
    c.CornerRadius = UDim.new(0, 6)
    
    local listening = false
    btn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        btn.Text = "[ 입력 대기 중 ]"
        btn.TextColor3 = Color3.fromRGB(255, 150, 0)
        
        local conn
        conn = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                conn:Disconnect()
                listening = false
                btn.Text = input.KeyCode.Name
                btn.TextColor3 = Color3.fromRGB(0, 120, 255)
                callback(input.KeyCode)
            end
        end)
    end)
end

CreateBindRow(BindFrame, "메뉴 열기/닫기", MenuBind, UDim2.new(0, 0, 0, 5), function(newKey) MenuBind = newKey end)
CreateBindRow(BindFrame, "스피드핵 토글", SpeedBind, UDim2.new(0, 0, 0, 40), function(newKey) SpeedBind = newKey end)
CreateBindRow(BindFrame, "플라이 토글", FlyBind, UDim2.new(0, 0, 0, 75), function(newKey) FlyBind = newKey end)
CreateBindRow(BindFrame, "에임봇 토글", AimBind, UDim2.new(0, 0, 0, 110), function(newKey) AimBind = newKey end)
CreateBindRow(BindFrame, "등 뒤 텔레포트", TpBind, UDim2.new(0, 0, 0, 145), function(newKey) 
    TpBind = newKey 
    UpdateTpBindText(newKey.Name)
end)

DynamicTpBindLabel = CreateContentLabel(OtherFrame, "[Q] 키를 꾹 누르면 적 뒤로 이동합니다", UDim2.new(0, 0, 0, 10))
DynamicTpBindLabel.TextColor3 = Color3.fromRGB(230, 230, 235)
UpdateTpBindText(TpBind.Name)

local function GetTarget()
    local t, d = nil, math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local mag = (p.Character.Head.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if mag < d then t = p.Character.Head d = mag end
        end
    end
    return t
end

local function ApplyTargetESP(targetPart)
    if not targetPart then 
        RemoveTargetHighlight()
        return 
    end
    
    local characterModel = targetPart.Parent
    if CurrentTargetModel ~= characterModel then
        RemoveTargetHighlight()
        
        CurrentTargetModel = characterModel
        TargetHighlight = Instance.new("Highlight")
        TargetHighlight.Name = "Aimbot_AutoESP"
        TargetHighlight.FillColor = Color3.fromRGB(0, 255, 100)
        TargetHighlight.FillTransparency = 0.5
        TargetHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        TargetHighlight.OutlineTransparency = 0
        TargetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        TargetHighlight.Parent = characterModel
    end
end

local function ResetTeleport()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        if OriginalPosition then
            hrp.Velocity = Vector3.new(0, 0, 0)
            hrp.CFrame = OriginalPosition
            OriginalPosition = nil
        end
    end
    isTeleporting = false
end

local function DoTeleport()
    if isTeleporting then return end
    
    local target = GetTarget()
    if target and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        OriginalPosition = hrp.CFrame
        isTeleporting = true
    end
end

