local FlySpeed = 50
local FlyEnabled = false
local AimbotEnabled = false
local OriginalPosition = nil

local FlyBtn
local AimBtn

local function UpdateVisual(btn, state, prefix)
    if state then
        btn.Text = prefix .. " 적용 됨"
        btn.BackgroundColor3 = Color3.fromRGB(46, 125, 50)
    else
        btn.Text = prefix .. " 적용 안됨"
        btn.BackgroundColor3 = Color3.fromRGB(38, 38, 41)
    end
end

YesBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
    AimbotEnabled = false
    FlyEnabled = false
    OriginalPosition = nil
    if FlyBtn and FlyBtn.Parent then
        UpdateVisual(FlyBtn, FlyEnabled, "FLY:")
    end
    if AimBtn and AimBtn.Parent then
        UpdateVisual(AimBtn, AimbotEnabled, "AIMBOT:")
    end
end)

NoBtn.MouseButton1Click:Connect(function()
    ConfirmFrame.Visible = false
    Main.Visible = true
end)

SubmitBtn.MouseButton1Click:Connect(function()
    local input = KeyInput.Text:gsub("[%c%s]", "")
    pcall(RefreshKeys)
    if table.find(ValidKeys, input) then
        SaveAuth()
        KeyFrame.Visible = false
        Main.Visible = true
        StatusMsg.Text = ""
    else
        StatusMsg.Text = "올바르지 않은 키입니다. 다시 확인해 주세요."
        task.wait(1.5)
        StatusMsg.Text = ""
    end
end)

local function GetTarget()
    local t, d = nil, math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
            local mag = (p.Character.Head.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if mag < d then t = p.Character.Head d = mag end
        end
    end
    return t
end

local function CreateBtn(pos)
    local btn = Instance.new("TextButton", Main)
    btn.Size = UDim2.new(0.88, 0, 0, 42)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(38, 38, 41)
    btn.TextColor3 = Color3.fromRGB(240, 240, 245)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    
    local c = Instance.new("UICorner", btn)
    c.CornerRadius = UDim.new(0, 6)
    
    return btn
end

FlyBtn = CreateBtn(UDim2.new(0.06, 0, 0.2, 0))
local function ToggleFly()
    if ScreenGui.Parent == nil then return end
    FlyEnabled = not FlyEnabled
    UpdateVisual(FlyBtn, FlyEnabled, "FLY:")
end
FlyBtn.MouseButton1Click:Connect(ToggleFly)
UpdateVisual(FlyBtn, FlyEnabled, "FLY:")

AimBtn = CreateBtn(UDim2.new(0.06, 0, 0.42, 0))
local function ToggleAim()
    if ScreenGui.Parent == nil then return end
    AimbotEnabled = not AimbotEnabled
    UpdateVisual(AimBtn, AimbotEnabled, "AIMBOT:")
end
AimBtn.MouseButton1Click:Connect(ToggleAim)
UpdateVisual(AimBtn, AimbotEnabled, "AIMBOT:")

local TpBtn = CreateBtn(UDim2.new(0.06, 0, 0.64, 0))
TpBtn.Text = "Q키를 꾹 눌러서 적 뒤로 순간이동"
TpBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 32)
TpBtn.TextColor3 = Color3.fromRGB(180, 180, 185)

UserInputService.InputBegan:Connect(function(input, gpe)
    if ScreenGui.Parent == nil then return end
    if gpe then return end
    
    if input.KeyCode == Enum.KeyCode.Z then
        ToggleFly()
    elseif input.KeyCode == Enum.KeyCode.X then
        ToggleAim()
    elseif input.KeyCode == Enum.KeyCode.Q then
        local target = GetTarget()
        if target and LocalPlayer.Character then
            OriginalPosition = LocalPlayer.Character.HumanoidRootPart.CFrame
            LocalPlayer.Character.HumanoidRootPart.CFrame = target.CFrame * CFrame.new(0, 0, 1.2) * CFrame.Angles(0, math.pi, 0)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if ScreenGui.Parent == nil then return end
    if input.KeyCode == Enum.KeyCode.Q and OriginalPosition then
        LocalPlayer.Character.HumanoidRootPart.CFrame = OriginalPosition
        OriginalPosition = nil
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if ScreenGui.Parent == nil then return end
    if FlyEnabled and LocalPlayer.Character then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        hrp.Velocity = Vector3.new(0,0,0)
        local m = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then m = m + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then m = m - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then m = m - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then m = m + Camera.CFrame.RightVector end
        hrp.CFrame = hrp.CFrame + (m * FlySpeed * dt)
    end
    if AimbotEnabled then
        local target = GetTarget()
        if target then Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position) end
    end
end)

local dragging, dragStart, startPos
MainTitle.InputBegan:Connect(function(input)
    if ScreenGui.Parent == nil then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
        
        local connection
        connection = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                connection:Disconnect()
            end
        end)
    end
end)

MainTitle.InputChanged:Connect(function(input)
    if ScreenGui.Parent == nil then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
